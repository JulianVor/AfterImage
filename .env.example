# Copy to .env for Docker Compose and replace both passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AFTERIMAGE_ADMIN_USERNAME=admin
AFTERIMAGE_ADMIN_PASSWORD=replace-with-a-long-random-password
AFTERIMAGE_WIKI_BASE_URL=https://wiki.fotosvorju.de
AFTERIMAGE_WIKI_API_URL=https://wiki.fotosvorju.de/w/api.php
AFTERIMAGE_WIKI_USERNAME=your-bot-username
AFTERIMAGE_WIKI_PASSWORD=your-bot-password
# Optional: restrict synchronization to this category. Empty means all main-namespace pages.
AFTERIMAGE_WIKI_SYNC_CATEGORY=
# Show imported Wiki article sections on public detail pages.
AFTERIMAGE_WIKI_CONTENT_ENABLED=true
AFTERIMAGE_PIWIGO_BASE_URL=https://galerie.fotosvorju.de
AFTERIMAGE_PIWIGO_ENABLED=true
AFTERIMAGE_PIWIGO_API_URL=https://galerie.fotosvorju.de/ws.php
# Piwigo 16.1+: complete value in the form pkid-...:secret
AFTERIMAGE_PIWIGO_API_KEY=
# Legacy fallback for older Piwigo versions only.
AFTERIMAGE_PIWIGO_USERNAME=
AFTERIMAGE_PIWIGO_PASSWORD=
AFTERIMAGE_PIWIGO_DEFAULT_PAGE_SIZE=50
